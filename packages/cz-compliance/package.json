{
  "name": "@faktur/cz-compliance",
  "version": "0.0.1",
  "private": true,
  "description": "CZ/SK tax & invoicing compliance logic (ARES lookup, ISDOC 6.0.2 export, SPAYD QR generation, CZ/SK bank account validation) — ported/reimplemented from the MIT-licensed Faktorio project.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pay-by-square": {
      "types": "./dist/pay-by-square.d.ts",
      "default": "./dist/pay-by-square.js"
    }
  },
  "typesVersions": {
    "*": {
      "pay-by-square": [
        "./dist/pay-by-square.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bysquare": "4.1.0"
  },
  "devDependencies": {
    "fast-xml-parser": "^4.5.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
