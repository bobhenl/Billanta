# apps/ai-service environment variables.
# Copy to `.env` for local development. In production, use Infisical or
# SOPS-encrypted secrets per blueprint §2/§8 - never commit a real `.env`.

ENVIRONMENT=development

# --- OpenAI (Whisper transcription + GPT-4o structured extraction) ---
# Required for transcribe_audio()/extract_invoice_data() in
# app/pipeline/voice_to_invoice.py (both are real implementations now, not
# stubs). This is the only newly-required variable for those two steps —
# transcription also needs the `ffmpeg` binary on PATH (see Dockerfile),
# not an env var.
OPENAI_API_KEY=

# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=
# Set via Telegram's setWebhook `secret_token` param; echoed back on every
# webhook call in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
# App secret used to verify X-Hub-Signature-256 on incoming webhooks.
WHATSAPP_APP_SECRET=
# Arbitrary token you choose and enter in the Meta App Dashboard webhook
# config; used only for the GET verification handshake.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Backend (NestJS) integration ---
# Internal Docker network URL in production (e.g. http://backend:3000).
BACKEND_API_URL=http://localhost:3000
# Scoped service JWT - draft-creation + channel-link resolution ONLY.
# Must NEVER be a superuser/admin token (blueprint §8, §9).
BACKEND_SERVICE_JWT=
