{
  "name": "@faktur/backend",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS REST API (OpenAPI-documented): Postgres + Drizzle ORM, shared-schema multi-tenancy enforced by Postgres Row-Level Security. See docs/CZ-SK-Invoicing-SaaS-Blueprint.md §2-§4, §6, §9.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:rls": "node -e \"console.log('Apply drizzle/rls-policies.sql manually, e.g.: psql \\\"$DATABASE_URL\\\" -f drizzle/rls-policies.sql')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@faktur/cz-compliance": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "age-encryption": "^0.3.1",
    "better-sqlite3": "^11.3.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "drizzle-orm": "^0.45.4",
    "nestjs-zod": "^3.0.0",
    "pdfkit": "^0.15.0",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.26.0",
    "rxjs": "^7.8.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "stripe": "^22.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.15",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/ssh2": "^1.15.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
