{
  "name": "@faktur/backend",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS REST API (OpenAPI-documented): Postgres + Drizzle ORM, shared-schema multi-tenancy enforced by Postgres Row-Level Security. See docs/CZ-SK-Invoicing-SaaS-Blueprint.md §2-§4, §6, §9.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:rls": "node -e \"console.log('Apply drizzle/rls-policies.sql manually, e.g.: psql \\\"$DATABASE_URL\\\" -f drizzle/rls-policies.sql')\""
  },
  "dependencies": {
    "@faktur/cz-compliance": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.2",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.33.0",
    "nestjs-zod": "^3.0.0",
    "postgres": "^3.4.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.26.0",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.24.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
