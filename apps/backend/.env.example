# apps/backend — backend-specific environment variables.
#
# The root ../../.env.example documents the full variable set shared across
# apps/backend, apps/frontend, and apps/ai-service (for docker-compose runs).
# This file is for running apps/backend standalone
# (`pnpm --filter @faktur/backend dev`) with its own `.env` in this
# directory. See docs/CZ-SK-Invoicing-SaaS-Blueprint.md §2, §4.

# --- Database (§4 Multi-Tenancy) ---
# The app's runtime connection MUST authenticate as a non-owner,
# NOBYPASSRLS role (see drizzle/rls-policies.sql) — never the table-owning
# migration role or a superuser, or RLS silently becomes a no-op.
DATABASE_URL=postgres://faktur:faktur@localhost:5432/faktur

# Default 3000 — matches what apps/ai-service's BACKEND_API_URL assumes by
# default (see apps/ai-service/.env.example).
PORT=3000

# --- Auth (§2) ---
# Used to verify both dashboard-user JWTs and the AI microservice's scoped
# BACKEND_SERVICE_JWT (see apps/ai-service/.env.example) once
# src/auth/jwt-auth.guard.ts's TODO is implemented.
JWT_SECRET=change-me

# Billanta staff who manage the partners catalogue (/api/v1/admin/partners), comma
# separated. The address must be confirmed (or a Google sign-in). Empty = nobody.
PLATFORM_ADMIN_EMAILS=

# --- Not yet wired up in this scaffold, but will be needed once billing
# (§5) and queue-backed jobs (ARES cache warmup, PDF/ISDOC generation) land:
REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Optional: UK Companies House API key for the "Velká Británie" company
# lookup. Free at https://developer.company-information.service.gov.uk/
# (register, create an application, add a REST key). Without it UK search
# falls back to the GLEIF LEI index.
# ---------------------------------------------------------------------------
COMPANIES_HOUSE_API_KEY=

# Optional: override the Fio API base URL (local mock in development).
# FIO_API_BASE_URL=https://fioapi.fio.cz/v1/rest

# Optional: PSD2 bank sync for other banks via Enable Banking
# (https://enablebanking.com). Create an application in its control panel,
# register <site>/bank/psd2-callback as the redirect URL, and paste the
# application id and its private key (PEM; \n escapes allowed) or a path to it.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/enable-banking.pem
# ENABLE_BANKING_REDIRECT_URL=http://localhost:3100/bank/psd2-callback
# ENABLE_BANKING_API_BASE_URL=https://api.enablebanking.com

# Optional: override the PayPal API endpoint (local mock). Each tenant enters
# its own PayPal REST app credentials in Bank -> Connect PayPal.
# PAYPAL_API_BASE_URL=https://api-m.paypal.com

# Abuse protection: daily caps on customer e-mails (invoices + reminders),
# where operator reports of suspicious documents go, and how many distinct
# reporters within 7 days pause a company's sending.
EMAIL_CAP_NEW_ACCOUNT=20
EMAIL_CAP_NEW_ACCOUNT_DAYS=7
EMAIL_CAP_TRIAL=100
EMAIL_CAP_PAID=1000
ABUSE_PAUSE_THRESHOLD=3
ABUSE_REPORT_EMAIL=
