# apps/backend — backend-specific environment variables.
#
# The root ../../.env.example documents the full variable set shared across
# apps/backend, apps/frontend, and apps/ai-service (for docker-compose runs).
# This file is for running apps/backend standalone
# (`pnpm --filter @faktur/backend dev`) with its own `.env` in this
# directory. See docs/CZ-SK-Invoicing-SaaS-Blueprint.md §2, §4.

# --- Database (§4 Multi-Tenancy) ---
# The app's runtime connection MUST authenticate as a non-owner,
# NOBYPASSRLS role (see drizzle/rls-policies.sql) — never the table-owning
# migration role or a superuser, or RLS silently becomes a no-op.
DATABASE_URL=postgres://faktur:faktur@localhost:5432/faktur

# Default 3000 — matches what apps/ai-service's BACKEND_API_URL assumes by
# default (see apps/ai-service/.env.example).
PORT=3000

# --- Auth (§2) ---
# Used to verify both dashboard-user JWTs and the AI microservice's scoped
# BACKEND_SERVICE_JWT (see apps/ai-service/.env.example) once
# src/auth/jwt-auth.guard.ts's TODO is implemented.
JWT_SECRET=change-me

# --- Not yet wired up in this scaffold, but will be needed once billing
# (§5) and queue-backed jobs (ARES cache warmup, PDF/ISDOC generation) land:
REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_WEBHOOK_SECRET=
