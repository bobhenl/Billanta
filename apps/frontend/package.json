{
  "name": "@faktur/frontend",
  "version": "0.0.1",
  "private": true,
  "description": "Next.js App Router dashboard for the CZ/SK invoicing SaaS — i18n (cs/sk/en) via next-intl, Tailwind CSS + shadcn/ui foundations. See blueprint §2 (tech stack), §6 (AI-draft review UX), §7 (i18n), §9 (legal/liability disclaimers).",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pdfjs:sync": "node -e \"for(const f of ['pdf.min.mjs','pdf.worker.min.mjs'])require('fs').copyFileSync('node_modules/pdfjs-dist/build/'+f,'public/pdfjs/'+f)\""
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@faktur/cz-compliance": "workspace:*",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^5.9.6",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.436.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^3.26.5",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.26.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
