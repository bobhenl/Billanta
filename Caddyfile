# Reverse proxy. Replace :80 with the real domain to get automatic HTTPS
# once deployed to the VPS — see docs/CZ-SK-Invoicing-SaaS-Blueprint.md §3.
#
# Public company profiles on subdomains (NEXT_PUBLIC_PROFILE_DOMAIN):
# serve `billanta.com, *.billanta.com` here, with a wildcard DNS record and
# a wildcard certificate (needs the DNS-01 challenge, i.e. a caddy-dns
# provider module). The frontend middleware rewrites <slug>.<domain>/ to
# /<locale>/p/<slug>.

:80 {
	encode zstd gzip

	header {
		# HSTS only takes effect over HTTPS; harmless on plain :80 in dev.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(), microphone=(self)"
		-Server
	}

	# Only the widgets under /embed may sit in an iframe on other sites
	# (apps/frontend/lib/embeds.ts), which send their own frame-ancestors.
	@notFramable not path /embed/*
	header @notFramable X-Frame-Options "SAMEORIGIN"

	# Public /ai-webhook/telegram|whatsapp -> ai-service /webhook/telegram|whatsapp.
	handle /ai-webhook/* {
		uri replace /ai-webhook/ /webhook/ 1
		reverse_proxy ai-service:8000
	}

	# The NestJS API is versioned under /api/v1 (+ Swagger at /api/docs).
	# Everything else under /api — Auth.js (/api/auth) and the Next.js route
	# handlers that proxy uploads/downloads (/api/files, /api/invoices/…) —
	# belongs to the frontend.
	handle /api/v1/* {
		# X-Guest-Ip is how the Next.js guest-invoice proxy tells the backend
		# the visitor's address (trusted from private IPs only). A client
		# calling /api/v1 directly must not be able to set it and dodge the
		# guest rate limits, so it is dropped here.
		reverse_proxy backend:3000 {
			header_up -X-Guest-Ip
		}
	}

	handle /api/docs* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
