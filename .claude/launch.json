{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@faktur/frontend",
        "dev"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@faktur/backend",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@faktur/frontend",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "backend-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@faktur/backend",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "backend-3001",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@faktur/backend", "dev"],
      "env": { "PORT": "3001" },
      "port": 3001
    },
    {
      "name": "frontend-b3001",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@faktur/frontend", "dev"],
      "env": { "BACKEND_URL": "http://localhost:3001" },
      "port": 3100
    },
    {
      "name": "frontend-prod-b3001",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@faktur/frontend", "start", "-p", "3100"],
      "env": { "BACKEND_URL": "http://localhost:3001" },
      "port": 3100
    },
    {
      "name": "remote-backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "C:/Programovani/OwnIdeas/Faktur-remote",
        "--filter",
        "@faktur/backend",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "remote-frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "C:/Programovani/OwnIdeas/Faktur-remote",
        "--filter",
        "@faktur/frontend",
        "dev"
      ],
      "port": 3100
    }
  ]
}
