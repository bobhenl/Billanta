# Faktur — root environment template.
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# Section references are to docs/CZ-SK-Invoicing-SaaS-Blueprint.md

# ---------------------------------------------------------------------------
# Database (§2 Tech Stack, §4 Multi-Tenancy)
# ---------------------------------------------------------------------------
# The app connects as `faktur_app` (no superuser, no BYPASSRLS), so RLS
# applies. POSTGRES_USER is the superuser that owns the tables and runs
# migrations; never point DATABASE_URL at it. Generate both passwords with
# `openssl rand -hex 24`. docker-compose builds the in-network DATABASE_URL
# itself; this one is for running the backend on the host.
DATABASE_URL=postgres://faktur_app:change-me@localhost:5432/faktur
APP_DB_PASSWORD=change-me
POSTGRES_USER=faktur
POSTGRES_PASSWORD=change-me
POSTGRES_DB=faktur

# ---------------------------------------------------------------------------
# Redis — queue + cache, BullMQ/redis-py, ARES cache (§2, §6)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth (§2 Auth.js / NextAuth v5, §4 tenant JWTs)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# GitHub OAuth app; callback <site>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional extra social sign-ins. Each button appears only when BOTH of its
# values are set (apps/frontend/lib/oauth-providers.ts).
# Microsoft (work/school Microsoft 365 + personal accounts): Entra ID app
# registration, redirect URI <site>/api/auth/callback/microsoft-entra-id.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0
# Apple: Services ID + generated client-secret JWT; redirect <site>/api/auth/callback/apple.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Seznam.cz ("Přihlásit se přes Seznam"): register at vyvojari.seznam.cz;
# redirect <site>/api/auth/callback/seznam.
SEZNAM_CLIENT_ID=
SEZNAM_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Billing — Stripe, primary payment provider (§5)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Billing — GoPay, CZ-local payment methods, fast-follow after Stripe (§5)
# ---------------------------------------------------------------------------
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI microservice — Whisper/GPT-4o transcription + extraction (§6)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# AI invoice pre-fill (apps/backend/src/ai/) — Anthropic Claude.
# ANTHROPIC_API_KEY: Billanta's own ("platform") key. Leave empty to offer
#   only bring-your-own-key; tenants can always add their own key in
#   Settings -> AI, stored AES-256-GCM encrypted.
# AI_MODEL: defaults to claude-opus-5.
# AI_PLATFORM_DAILY_LIMIT: suggestions per tenant per day on the platform key.
# AI_KEY_ENCRYPTION_KEY: 64 hex chars (32 bytes) for tenants' own keys;
#   falls back to BACKUP_CONFIG_ENCRYPTION_KEY when unset.
# OPENAI_API_KEY above is still used by apps/ai-service for Whisper voice
# transcription (audio), which Claude does not do.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_PLATFORM_DAILY_LIMIT=50
# Public "invoice without an account" page: AI fill tries per visitor per day,
# and for all visitors together per day (platform key).
GUEST_AI_PER_VISITOR=3
GUEST_AI_DAILY_LIMIT=200
AI_KEY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AI microservice — Telegram voice-to-invoice channel (§6, Phase 5)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Bot username without @ (frontend builds the t.me/<bot>?start=<code> link)
TELEGRAM_BOT_USERNAME=billanta_bot
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI microservice — WhatsApp (Meta Cloud API) voice-to-invoice channel (§6, Phase 6)
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Email — Resend, invoice sending + overdue-payment-reminder digest
# (apps/backend/src/email/, invoices.controller.ts's POST .../:id/send,
# invoice-reminders.cron.ts), AND the frontend's forgot/reset-password email
# (apps/frontend/lib/email.ts, app/api/auth/forgot-password/route.ts) — same
# two vars, reused as-is, not duplicated. Resend is a hosted third-party API
# (https://resend.com) reached over plain HTTPS requests, not a mail server
# you run or deploy yourself — there is no corresponding service in
# docker-compose.yml, just these two credentials. EMAIL_FROM must be a
# Resend-verified sender (e.g. "Faktur <faktura@yourdomain.tld>").
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# Outbox, unsubscribe and bounces (apps/backend/src/email/). Backend mail is
# queued in email_outbox and sent by a once-a-minute worker; with no
# RESEND_API_KEY the rows just wait and nothing is sent.
# RESEND_WEBHOOK_SECRET is the "whsec_..." signing secret of a Resend webhook
# pointed at https://<site>/api/v1/webhooks/resend (events email.delivered,
# email.bounced, email.complained); without it the endpoint answers 503.
# Hard bounces and spam complaints suppress the address for good.
# Unsubscribe links are signed with a key derived from JWT_SECRET and point
# at NEXT_PUBLIC_SITE_URL. The admin queue view (GET /api/v1/admin/email-outbox)
# uses PLATFORM_ADMIN_EMAILS.
# The rest are optional tuning; leave empty for the defaults: 15 min batch
# window, 6 attempts, give up after 72 h, 50 e-mails per worker run.
RESEND_WEBHOOK_SECRET=
EMAIL_BATCH_WINDOW_MINUTES=
EMAIL_MAX_ATTEMPTS=
EMAIL_OUTBOX_MAX_AGE_HOURS=
EMAIL_OUTBOX_BATCH_SIZE=

# ---------------------------------------------------------------------------
# Secrets management — Infisical, or omit entirely and rely on this .env /
# SOPS-encrypted .env fallback instead (§2 Secrets, optional)
# ---------------------------------------------------------------------------
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev

# ---------------------------------------------------------------------------
# Observability — Sentry error tracking (§2 Observability)
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Backups — nightly pg_dump -> Google Drive via rclone sidecar (apps/backup,
# §8). One-time setup, done by the founder outside this repo: install
# rclone locally, run `rclone config` to authorize Google Drive (browser
# OAuth), then copy the generated config to ./rclone.conf at the repo root
# (gitignored, mounted read-only into the `backup` service). Full walkthrough,
# manual-trigger instructions, and the RESTORE procedure are in
# apps/backup/README.md. B2/S3 remain a drop-in alternative later -- same
# script, just a different rclone remote, no code changes.
# ---------------------------------------------------------------------------
BACKUP_RCLONE_REMOTE=gdrive:faktur-backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24

# ---------------------------------------------------------------------------
# Frontend / SEO — canonical public origin, used for sitemap.xml, robots.txt,
# and canonical/hreflang tags (apps/frontend/lib/site.ts). No production
# domain is registered yet; the app falls back to a placeholder if unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# Optional wildcard domain for public company profiles (Settings → Veřejný
# profil): "billanta.com" makes novak.billanta.com serve /cs/p/novak. Needs a
# *.domain DNS record and a wildcard TLS certificate (Caddy: DNS challenge).
# Empty = profiles only at <site>/<locale>/p/<slug>.
NEXT_PUBLIC_PROFILE_DOMAIN=

# Microsoft Clarity project ID (clarity.microsoft.com -> Settings -> Overview).
# Optional: when empty, no analytics script is ever loaded. When set, Clarity
# still loads only after a visitor accepts analytics cookies, and only on the
# public marketing pages (apps/frontend/components/clarity.tsx).
NEXT_PUBLIC_CLARITY_ID=

# ---------------------------------------------------------------------------
# Frontend -> backend server-side integration — apps/frontend/lib/public-
# invoices.ts (client-portal page, app/[locale]/i/[token]/page.tsx) fetches
# the NestJS backend's public API directly from a Server Component. Plain
# (non-`NEXT_PUBLIC_*`) var: this is only ever read server-side, never
# bundled to the browser. Defaults to the backend's own default dev port
# (apps/backend/src/main.ts) if unset.
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Per-tenant backup destinations (apps/backend/src/backup-destinations/) —
# NOT the platform-wide apps/backup pg_dump-to-Drive sidecar; see
# apps/backend/README.md's "Per-tenant backup destinations" section for the
# distinction. A tenant owner can export THEIR OWN data (queried through the
# normal RLS-scoped path) to their own Google Drive or a webhook they
# control. Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above via a separate
# OAuth consent flow requesting the drive.file scope — no second registered
# OAuth app needed.
#
# BACKUP_CONFIG_ENCRYPTION_KEY: a 32-byte key, hex-encoded (64 hex chars),
# used for AES-256-GCM encryption of stored Google Drive refresh tokens /
# webhook signing secrets (backup_destinations.config_encrypted) — this must
# be REVERSIBLE (unlike api_keys.key_hash), so it's encrypted, not hashed.
# Generate one with: openssl rand -hex 32
# ---------------------------------------------------------------------------
BACKUP_CONFIG_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional: UK Companies House API key for the "Velká Británie" company
# lookup. Free at https://developer.company-information.service.gov.uk/
# (register, create an application, add a REST key). Without it UK search
# falls back to the GLEIF LEI index.
# ---------------------------------------------------------------------------
COMPANIES_HOUSE_API_KEY=
